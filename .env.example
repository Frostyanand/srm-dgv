# ==============================================================================
# SRM Digital Approval & Document Verification Platform (SRM DGV)
# Environment Configuration Template
# ==============================================================================
# Copy this file to `.env` and populate the actual secrets for your project.
# NEVER commit your actual `.env` file to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Supabase Storage Configuration
# Create a Supabase project at https://supabase.com
# Create a Storage Bucket named: encrypted_documents (Make it PRIVATE!)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-or-publishable-key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
SUPABASE_BUCKET_NAME=encrypted_documents
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ------------------------------------------------------------------------------
# 2. Firebase Web Client SDK Configuration
# In Firebase Console > Project Settings > General > Your apps (Web app)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSy...
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-firebase-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-firebase-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-firebase-project.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=000000000000
NEXT_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:abcdef123456

# ------------------------------------------------------------------------------
# 3. Firebase Admin SDK Configuration (Server-Side)
# In Firebase Console > Project Settings > Service Accounts > Generate New Private Key
# ------------------------------------------------------------------------------
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-firebase-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"

# ------------------------------------------------------------------------------
# 4. Cryptographic Master Security Keys (Zero-Trust Ledger & Envelope Encryption)
# Generate 32-byte hex strings via: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ------------------------------------------------------------------------------
MASTER_FILE_ENCRYPTION_KEY=your_64_char_hex_key_for_file_encryption
MASTER_PRIVATE_KEY_ENCRYPTION_KEY=your_64_char_hex_key_for_private_keys
MASTER_AUDIT_KEY=your_64_char_hex_key_for_audit_hmac_chain
INTERNAL_API_KEY=your_internal_shared_secret_token

# ------------------------------------------------------------------------------
# 5. Email Provider Configuration
# Obtain from https://resend.com/api-keys
# ------------------------------------------------------------------------------
RESEND_API_KEY=re_your_resend_api_key_here

# ------------------------------------------------------------------------------
# 6. Initial Seed SuperAdmin Reference (For development only)
# ------------------------------------------------------------------------------
# Email: superadmin@srmist.edu.in
